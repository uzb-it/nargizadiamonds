# Пароль для входа в админку /admin
ADMIN_PASSWORD=change-me
# Секрет для подписи сессии админа (любая длинная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# База PostgreSQL. Для разработки её создаёт npm run db:start
DATABASE_URL=postgres://nargiza:change-me@127.0.0.1:5544/nargiza
# (необязательно) уведомления о заказах в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
